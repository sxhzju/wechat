# 脱敏配置模板：以下所有值均为 placeholder，使用前须替换。
# 公众号 AppID：已脱敏，请填写自己的公众号标识。
WECHAT_APP_ID=YOUR_WECHAT_APP_ID

# 公众号 AppSecret：已脱敏，请填写自己的密钥，勿提交到 Git。
WECHAT_APP_SECRET=YOUR_WECHAT_APP_SECRET

# SSH 用户名及服务器地址：已脱敏，请替换为自己的用户名和主机/IP。
WECHAT_SSH_HOST=YOUR_SSH_USER@YOUR_SSH_HOST

# SSH 私钥路径：已脱敏，仅为占位路径，请填写自己的私钥文件路径。
WECHAT_SSH_KEY=~/.ssh/YOUR_SSH_PRIVATE_KEY

# SSH 主机公钥记录路径：已脱敏，请填写自己核验过的 known_hosts 文件路径。
WECHAT_SSH_KNOWN_HOSTS=~/.ssh/YOUR_SSH_KNOWN_HOSTS

